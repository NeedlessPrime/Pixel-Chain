# Copy to .env (repo root) and adjust; the server loads it on start.
# Variables already set in the environment win. Full list: docs/ARCHITECTURE.md.

# mock = fake balances to test before launch; live = real $PIXEL balances on Solana.
# Default: mock without TOKEN_MINT, live as soon as TOKEN_MINT is set (never force mock with a real mint).
# MODE=mock
PORT=8787
# Relative paths are resolved from server/
# DATA_DIR=./data  (default: server/data; the Docker image uses /data)
# Number of proxies in front, usually 1 (nginx, Caddy, Cloudflare), so rate limits see real client IPs.
# 0 = no proxy. Or a comma-separated list of proxy IPs/CIDRs, e.g. 172.17.0.1,10.0.0.0/8
TRUST_PROXY=0

# Enables /admin (moderation): long random string, e.g. `openssl rand -hex 24`; empty disables /admin
ADMIN_TOKEN=

# Required in live mode
TOKEN_MINT=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Global cap on balance reads sent to the RPC (bursts up to twice this)
# RPC_MAX_RPS=20
# BUY_URL=https://pump.fun/coin/<mint>

# Holding tiers (UI amounts). Slowest must stay <= 60000 ms.
# TIERS=[{"id":"whale","label":"Baleine","minBalance":1000000,"cooldownMs":5000},{"id":"holder","label":"Holder","minBalance":100000,"cooldownMs":30000},{"id":"player","label":"Joueur","minBalance":10000,"cooldownMs":60000}]

# Seasons
SEASON_DAYS=7
SEASON_BREAK_MINUTES=60
CHAOS_HOURS=24
CHAOS_FACTOR=0.5
CANVAS_WIDTH=200
CANVAS_HEIGHT=200
SEASON_THEMES=Les mèmes de Solana|Pixel libre|Le drapeau de ta commu
# FACTIONS=Team A|Team B

# Logo stamped on the canvas when a season ends (PNG, transparent background).
# Default: server/assets/logo.png if present, else a built-in "$PIXEL" pixel font.
# LOGO_PATH=/absolute/path/to/logo.png
LOGO_POSITION=bottom-right
