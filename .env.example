# Copy to .env and adjust. Full list: docs/ARCHITECTURE.md ("Configuration").

# mock = fake balances to test before launch; live = real $PIXEL balances on Solana
MODE=mock
PORT=8787
DATA_DIR=./data

# Enables /admin (moderation). Use a long random string.
ADMIN_TOKEN=change-me

# Required in live mode
TOKEN_MINT=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# BUY_URL=https://pump.fun/coin/<mint>

# Holding tiers (UI amounts). Slowest must stay <= 60000 ms.
# TIERS=[{"id":"whale","label":"Baleine","minBalance":1000000,"cooldownMs":5000},{"id":"holder","label":"Holder","minBalance":100000,"cooldownMs":30000},{"id":"player","label":"Joueur","minBalance":10000,"cooldownMs":60000}]

# Seasons
SEASON_DAYS=7
SEASON_BREAK_MINUTES=60
CHAOS_HOURS=24
CHAOS_FACTOR=0.5
CANVAS_WIDTH=200
CANVAS_HEIGHT=200
SEASON_THEMES=Les mèmes de Solana|Pixel libre|Le drapeau de ta commu
# FACTIONS=Team A|Team B

# Logo stamped on the canvas when a season ends (PNG, transparent background)
# LOGO_PATH=server/assets/logo.png
LOGO_POSITION=bottom-right
